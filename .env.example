# Paystack public key used by the browser checkout popup.
# Use pk_test_... locally and configure the live key only in production.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# SCA API base URL. Auth uses httpOnly cookies, so this must be an origin
# listed in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_URL=http://localhost:8080
